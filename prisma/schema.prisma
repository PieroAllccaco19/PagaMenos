// PagaMenos — Prisma schema.
//
// M3.5A introduces the durable, immutable, idempotent persistence boundary for completed pure-engine
// decisions: `DecisionSnapshot` (one immutable row per domain decision) and
// `DecisionIdempotencyReceipt` (append-only durable receipts that alias one-or-more transport
// idempotency keys to a single snapshot). Migrations are explicit and version-controlled — no ORM
// auto-sync (`prisma db push`) and no startup auto-migrate.
//
// Immutability is enforced at the DATABASE level (append-only) for BOTH tables: BEFORE UPDATE /
// BEFORE DELETE / BEFORE TRUNCATE triggers RAISE EXCEPTION. Those triggers are not expressible in the
// Prisma schema language, so they live in the migration SQL (prisma/migrations/*/migration.sql) and
// are guarded by the offline `pnpm db:migrate:check` gate. Nothing here may be relied upon as the
// sole immutability guarantee.
//
// Later study-domain models (Participant, PurchaseOccasion, VerifiedValue, …) are deliberately NOT
// created yet — they belong to M3.5B, designed together so their scientific invariants stay coherent.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// An immutable, append-only historical record of one completed engine decision (§5/§6/§12).
///
/// The exact effective engine input/output are stored verbatim as JSONB (`engineInputJson` /
/// `engineOutputJson`) — the historical source of truth, self-contained and independent of the
/// current corpus/rule/operational state (§3/§6). The typed columns are duplicated ONLY for efficient
/// lookup and integrity (§21); they never redefine the JSON truth. `inputHash` / `outputHash` are
/// SHA-256 fingerprints over the canonical serialization of those payloads (§8/§28).
///
/// No `updatedAt` (§13): the record has no mutable lifecycle. Corrections create NEW domain records,
/// never edits. Database triggers forbid UPDATE and DELETE (see migration SQL).
model DecisionSnapshot {
  /// DB-assigned identity (gen_random_uuid()); the application never supplies it.
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  /// Domain-level completed-decision occurrence key (§11). UNIQUE — one snapshot per domain decision.
  /// M3.5B binds how a future PurchaseIntent constructs this; M3.5A only enforces its uniqueness.
  /// Transport idempotency keys are NOT stored here; they live in DecisionIdempotencyReceipt so that
  /// several successful keys can durably alias one snapshot (P35A-01).
  businessDecisionKey String @unique

  /// Versioning (§5/§7) — pins how to read this record forever.
  snapshotSchemaVersion     String
  engineInputSchemaVersion  String
  engineOutputSchemaVersion String
  engineContractVersion     String

  /// Which factual corpus produced this decision (§6). Duplicated for query; the JSON holds the truth.
  corpusVersion String

  /// Queryable metadata lifted from the engine output (§21) — never the source of truth.
  merchantId      String
  selectedScopeId String?
  decisionStatus  String

  /// Offset-bearing instants preserved as timestamptz (§22).
  evaluatedAt           DateTime @db.Timestamptz(6)
  intendedTransactionAt DateTime @db.Timestamptz(6)

  /// The exact historical engine input/output (§6). JSONB. Immutable.
  engineInputJson  Json @db.JsonB
  engineOutputJson Json @db.JsonB

  /// SHA-256 (hex) fingerprints over the canonical serialization of the JSON payloads (§8).
  inputHash  String
  outputHash String

  /// Application build metadata at the persistence boundary (§9). gitSha required; buildId optional.
  gitSha  String
  buildId String?

  /// Insertion instant (§13 — createdAt only; no updatedAt).
  createdAt DateTime @default(now()) @db.Timestamptz(6)

  /// Durable idempotency receipts aliasing transport keys to this snapshot (P35A-01).
  receipts DecisionIdempotencyReceipt[]

  @@index([merchantId])
  @@index([corpusVersion])
  @@index([decisionStatus])
  @@index([evaluatedAt])
  @@index([intendedTransactionAt])
  @@map("decision_snapshot")
}

/// An append-only durable receipt that a transport idempotency key successfully resolved to a
/// specific historical DecisionSnapshot (P35A-01). Several receipts may point to ONE snapshot (an
/// alias created when a different key carries the same request). Every key under which the operation
/// returned success stays permanently consumed — a consumed key can never be reused for a different
/// request. `requestHash` fingerprints the effective request `{businessDecisionKey, validated input}`
/// (never the engine output, git sha, or build id, §7), so a retry after a deployment still resolves.
///
/// Immutable at the DATABASE level (append-only): UPDATE / DELETE / TRUNCATE are rejected by triggers
/// (see migration SQL). `operationScope` is trusted system input (a fixed operation identity), never a
/// request-controlled value (§4).
model DecisionIdempotencyReceipt {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  /// Trusted operation identity scoping the key namespace (e.g. DECISION_PERSIST_V1). Not caller data.
  operationScope String

  /// Transport/request idempotency key (§10). Unique within its operationScope.
  idempotencyKey String

  /// Deterministic fingerprint of the effective request (businessDecisionKey + validated input, §7).
  requestHash String

  /// The historical snapshot this key resolved to.
  decisionSnapshotId String           @db.Uuid
  snapshot           DecisionSnapshot @relation(fields: [decisionSnapshotId], references: [id])

  createdAt DateTime @default(now()) @db.Timestamptz(6)

  @@unique([operationScope, idempotencyKey])
  @@index([decisionSnapshotId])
  @@map("decision_idempotency_receipt")
}
