// PagaMenos — Prisma schema.
//
// M3.5A introduces the durable, immutable, idempotent persistence boundary for completed pure-engine
// decisions: `DecisionSnapshot` (one immutable row per domain decision) and
// `DecisionIdempotencyReceipt` (append-only durable receipts that alias one-or-more transport
// idempotency keys to a single snapshot). Migrations are explicit and version-controlled — no ORM
// auto-sync (`prisma db push`) and no startup auto-migrate.
//
// Immutability is enforced at the DATABASE level (append-only) for BOTH tables: BEFORE UPDATE /
// BEFORE DELETE / BEFORE TRUNCATE triggers RAISE EXCEPTION. Those triggers are not expressible in the
// Prisma schema language, so they live in the migration SQL (prisma/migrations/*/migration.sql) and
// are guarded by the offline `pnpm db:migrate:check` gate. Nothing here may be relied upon as the
// sole immutability guarantee.
//
// Later study-domain models (Participant, PurchaseOccasion, VerifiedValue, …) are deliberately NOT
// created yet — they belong to M3.5B, designed together so their scientific invariants stay coherent.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// An immutable, append-only historical record of one completed engine decision (§5/§6/§12).
///
/// The exact effective engine input/output are stored verbatim as JSONB (`engineInputJson` /
/// `engineOutputJson`) — the historical source of truth, self-contained and independent of the
/// current corpus/rule/operational state (§3/§6). The typed columns are duplicated ONLY for efficient
/// lookup and integrity (§21); they never redefine the JSON truth. `inputHash` / `outputHash` are
/// SHA-256 fingerprints over the canonical serialization of those payloads (§8/§28).
///
/// No `updatedAt` (§13): the record has no mutable lifecycle. Corrections create NEW domain records,
/// never edits. Database triggers forbid UPDATE and DELETE (see migration SQL).
model DecisionSnapshot {
  /// DB-assigned identity (gen_random_uuid()); the application never supplies it.
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  /// Domain-level completed-decision occurrence key (§11). UNIQUE — one snapshot per domain decision.
  /// M3.5B binds how a future PurchaseIntent constructs this; M3.5A only enforces its uniqueness.
  /// Transport idempotency keys are NOT stored here; they live in DecisionIdempotencyReceipt so that
  /// several successful keys can durably alias one snapshot (P35A-01).
  businessDecisionKey String @unique

  /// Versioning (§5/§7) — pins how to read this record forever.
  snapshotSchemaVersion     String
  engineInputSchemaVersion  String
  engineOutputSchemaVersion String
  engineContractVersion     String

  /// Which factual corpus produced this decision (§6). Duplicated for query; the JSON holds the truth.
  corpusVersion String

  /// Queryable metadata lifted from the engine output (§21) — never the source of truth.
  merchantId      String
  selectedScopeId String?
  decisionStatus  String

  /// Offset-bearing instants preserved as timestamptz (§22).
  evaluatedAt           DateTime @db.Timestamptz(6)
  intendedTransactionAt DateTime @db.Timestamptz(6)

  /// The exact historical engine input/output (§6). JSONB. Immutable.
  engineInputJson  Json @db.JsonB
  engineOutputJson Json @db.JsonB

  /// SHA-256 (hex) fingerprints over the canonical serialization of the JSON payloads (§8).
  inputHash  String
  outputHash String

  /// Application build metadata at the persistence boundary (§9). gitSha required; buildId optional.
  gitSha  String
  buildId String?

  /// Insertion instant (§13 — createdAt only; no updatedAt).
  createdAt DateTime @default(now()) @db.Timestamptz(6)

  /// Durable idempotency receipts aliasing transport keys to this snapshot (P35A-01).
  receipts DecisionIdempotencyReceipt[]

  /// M3.5B-A2 virtual back-relation (Prisma 6.x relational completeness ONLY; NO SQL column, no stored/
  /// economic change to decision_snapshot). The exact 1:1 intent↔snapshot binding FK lives on the A2
  /// `purchase_intent_decision_binding` table (SCI-A2-13; A2 §20).
  purchaseIntentDecisionBinding PurchaseIntentDecisionBinding?

  @@index([merchantId])
  @@index([corpusVersion])
  @@index([decisionStatus])
  @@index([evaluatedAt])
  @@index([intendedTransactionAt])
  @@map("decision_snapshot")
}

/// An append-only durable receipt that a transport idempotency key successfully resolved to a
/// specific historical DecisionSnapshot (P35A-01). Several receipts may point to ONE snapshot (an
/// alias created when a different key carries the same request). Every key under which the operation
/// returned success stays permanently consumed — a consumed key can never be reused for a different
/// request. `requestHash` fingerprints the effective request `{businessDecisionKey, validated input}`
/// (never the engine output, git sha, or build id, §7), so a retry after a deployment still resolves.
///
/// Immutable at the DATABASE level (append-only): UPDATE / DELETE / TRUNCATE are rejected by triggers
/// (see migration SQL). `operationScope` is trusted system input (a fixed operation identity), never a
/// request-controlled value (§4).
model DecisionIdempotencyReceipt {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  /// Trusted operation identity scoping the key namespace (e.g. DECISION_PERSIST_V1). Not caller data.
  operationScope String

  /// Transport/request idempotency key (§10). Unique within its operationScope.
  idempotencyKey String

  /// Deterministic fingerprint of the effective request (businessDecisionKey + validated input, §7).
  requestHash String

  /// The historical snapshot this key resolved to.
  decisionSnapshotId String           @db.Uuid
  snapshot           DecisionSnapshot @relation(fields: [decisionSnapshotId], references: [id])

  createdAt DateTime @default(now()) @db.Timestamptz(6)

  @@unique([operationScope, idempotencyKey])
  @@index([decisionSnapshotId])
  @@map("decision_idempotency_receipt")
}

// ===================================================================================================
// M3.5B-A1 — Protocol / Experiment / Assignment / Consent authority (spec V2.1).
//
// ADDITIVE over accepted M3.5A: no M3.5A table, enum, or FK above is altered (SCI-24). Every A1
// scientific table is append-only at the DATABASE level (BEFORE UPDATE/DELETE/TRUNCATE triggers that
// RAISE), except `AnalysisProtocol` (freeze-guarded: one DRAFT→FROZEN UPDATE, then immutable) and
// `Experiment` (immutable immediately after insert). Those triggers, the §8.11 consent CHECK, the
// receipt operationScope/resultKind CHECKs, and the "Experiment must reference a FROZEN protocol"
// guard are NOT expressible in Prisma and live in the migration SQL, gated by `pnpm db:migrate:check`.
// ===================================================================================================

/// AnalysisProtocol lifecycle (spec §2). One-way DRAFT → FROZEN; enforced by the freeze-guard trigger.
enum AnalysisProtocolLifecycle {
  DRAFT
  FROZEN
}

/// Consent event action (spec §8.1). GRANTED carries provenance + NULL assertedEffectiveAt (§8.11);
/// WITHDRAWN carries NULL provenance + optional assertedEffectiveAt.
enum StudyConsentAction {
  GRANTED
  WITHDRAWN
}

/// Consent command receipt result (spec §8.9) — makes replay independently interpretable.
enum StudyConsentResultKind {
  EVENT_APPENDED
  NO_OP_EFFECTIVE_STATE
  CORRECTION_NOT_APPLIED
}

/// A single authoritative analysis-protocol representation (spec §2). NO lifted semantic scalar
/// columns — all scientific semantics live in the verified `definitionJson`; `definitionDigest` =
/// sha256(canonical(definitionJson)) @`canonicalizationVersion`. Registration inserts a complete
/// DRAFT; freeze performs the ONLY permitted UPDATE (lifecycleStatus DRAFT→FROZEN, frozenAt
/// NULL→trusted), every other column byte/semantically unchanged; after FROZEN the row is immutable
/// and delete-protected (freeze-guard trigger, migration SQL). DRAFT editing is not provided.
model AnalysisProtocol {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  /// Stable protocol-version identity (spec §2). UNIQUE — one row per version; a revision is a NEW row.
  protocolVersion String @unique

  /// Frozen local schema version used to parse `definitionJson` forever (historical dispatch, §2.1).
  definitionSchemaVersion String

  /// Canonicalization version used to serialize `definitionJson` for the digest forever (§2.1).
  canonicalizationVersion String

  /// The exact normalized definition (source of truth for ALL protocol semantics). JSONB. Immutable.
  definitionJson Json @db.JsonB

  /// SHA-256 (hex) over canonical(definitionJson) @`canonicalizationVersion` (§2). Re-verified fail-closed.
  definitionDigest String

  lifecycleStatus AnalysisProtocolLifecycle

  /// Trusted freeze instant; NULL while DRAFT, set once (NULL→trusted) at freeze.
  frozenAt DateTime? @db.Timestamptz(6)

  createdAt DateTime @default(now()) @db.Timestamptz(6)

  experiments Experiment[]
  receipts    AnalysisProtocolCommandReceipt[]

  @@index([lifecycleStatus])
  @@map("analysis_protocol")
}

/// An experiment bound to exactly one FROZEN AnalysisProtocol (spec §4). No `recruitmentPolicy`, no
/// `assignedProtocolId`: the sole protocol path is `assignment → experiment → frozen protocol`.
/// `frozenProtocolId` must reference a FROZEN protocol (FK + insert-time guard trigger). Immutable
/// immediately after creation (no ordinary UPDATE/DELETE/TRUNCATE; triggers RAISE).
model Experiment {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  experimentCode String @unique

  frozenProtocolId String           @db.Uuid
  frozenProtocol   AnalysisProtocol @relation(fields: [frozenProtocolId], references: [id])

  createdAt DateTime @default(now()) @db.Timestamptz(6)

  assignments ExperimentAssignment[]
  receipts    ExperimentCreateReceipt[]

  @@index([frozenProtocolId])
  @@map("experiment")
}

/// DURABLE recruitment-subject identity issuance (spec §5/§10/§11; A1-CODE-02). Lives in the trusted
/// recruitment/identity boundary, NOT study truth — no PII, no raw email. Once a subject anchor is
/// issued a `(recruitmentSubjectKey, recruitmentKeyVersion)`, that pair is authoritative FOREVER: a
/// later default key-version advance affects only anchors never issued before. Append-only.
model RecruitmentSubjectIdentity {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  /// Trusted pseudonymous subject anchor (identity-boundary key; no PII).
  subjectAnchor String @unique

  /// The stable pseudonymous domain key issued for this subject, and its frozen normalization version.
  recruitmentSubjectKey String @unique
  recruitmentKeyVersion String

  createdAt DateTime @default(now()) @db.Timestamptz(6)

  @@map("recruitment_subject_identity")
}

/// DURABLE credential → subject-anchor binding (spec §5/§13; A1-CODE-02). A rotating invitation/
/// magic-link credential is bound once to a subject anchor; a credential already bound to one anchor
/// may not silently become another (reassignment is a conflict). No PII study truth. Append-only.
model RecruitmentCredentialLink {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  /// The rotating recruitment credential (invite/magic-link token; not study truth, not participant id).
  credential String @unique

  /// The durable subject anchor this credential belongs to.
  subjectAnchor String

  createdAt DateTime @default(now()) @db.Timestamptz(6)

  @@index([subjectAnchor])
  @@map("recruitment_credential_link")
}

/// A study participant keyed by a STABLE, research-issued pseudonymous `recruitmentSubjectKey` (spec
/// §5) — never a reissuable invitation/magic-link credential and never raw email. `participantCode`
/// is an opaque public pseudonym generated AFTER dedup. Append-only (no UPDATE/DELETE/TRUNCATE).
model StudyParticipant {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  /// Stable pseudonymous domain identity; UNIQUE (pre-creation dedup). No PII; not participant-authored.
  recruitmentSubjectKey String @unique

  /// Frozen normalization version of the recruitment-subject key.
  recruitmentKeyVersion String

  /// Opaque participant-facing pseudonym; UNIQUE; system-issued after dedup.
  participantCode String @unique

  createdAt DateTime @default(now()) @db.Timestamptz(6)

  assignments ExperimentAssignment[]
  receipts    StudyParticipantRegistrationReceipt[]

  @@map("study_participant")
}

/// Immutable official-population membership fact (spec §7). `enrolledAt` is trusted (system clock);
/// `observationStartAt = enrolledAt`; no caller anchor/window/protocol id. `observationEndAt` is
/// derived at analysis from the frozen protocol, never stored. NOT deleted on withdrawal
/// (append-only: no UPDATE/DELETE/TRUNCATE).
model ExperimentAssignment {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  experimentId String     @db.Uuid
  experiment   Experiment @relation(fields: [experimentId], references: [id])

  participantId String           @db.Uuid
  participant   StudyParticipant @relation(fields: [participantId], references: [id])

  /// Trusted enrollment instant (system clock, sampled by the service).
  enrolledAt DateTime @db.Timestamptz(6)

  /// Observation window anchor; equal to `enrolledAt` (§7).
  observationStartAt DateTime @db.Timestamptz(6)

  createdAt DateTime @default(now()) @db.Timestamptz(6)

  consentEvents StudyConsentEvent[]
  receipts      ExperimentAssignmentReceipt[]

  /// M3.5B-A2 virtual back-relations (Prisma 6.x relational completeness ONLY; NO SQL column, no
  /// stored/economic change to experiment_assignment). The FK columns live on the A2 child tables.
  purchaseIntentCaptureTokens PurchaseIntentCaptureToken[]
  eligibilityProfileVersions  EligibilityProfileVersion[]

  @@unique([experimentId, participantId])
  @@index([experimentId])
  @@index([participantId])
  @@map("experiment_assignment")
}

/// Append-only consent event stream per assignment (spec §8). Ordered by `consentSeq` (never by
/// asserted time). Provenance (`consentVersion`/`privacyNoticeVersion`/`optionalEvidenceConsent`) is
/// NOT NULL on GRANTED and NULL on WITHDRAWN; `assertedEffectiveAt` is NULL on GRANTED (§8.11 CHECK,
/// migration SQL) and optional on WITHDRAWN. `capturedAt` is trusted (sampled under the assignment
/// row lock). Append-only (no UPDATE/DELETE/TRUNCATE).
model StudyConsentEvent {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  assignmentId String               @db.Uuid
  assignment   ExperimentAssignment @relation(fields: [assignmentId], references: [id])

  /// Per-assignment strictly-increasing sequence; the ONLY ordering/authorization authority.
  consentSeq Int

  action StudyConsentAction

  /// GRANTED: NOT NULL. WITHDRAWN: NULL. (§8.11 CHECK.)
  consentVersion String?

  /// GRANTED: NOT NULL. WITHDRAWN: NULL. (§8.11 CHECK.)
  privacyNoticeVersion String?

  /// GRANTED: NOT NULL. WITHDRAWN: NULL. (§8.11 CHECK.)
  optionalEvidenceConsent Boolean?

  /// GRANTED: MUST be NULL (§8.11 CHECK). WITHDRAWN: MAY be NULL; can narrow retrospective authz (§8.6).
  assertedEffectiveAt DateTime? @db.Timestamptz(6)

  /// Trusted authorization instant, sampled under the assignment row lock (§8.10).
  capturedAt DateTime @db.Timestamptz(6)

  /// Knowledge time (when the fact was recorded).
  recordedAt DateTime @default(now()) @db.Timestamptz(6)

  receipts StudyConsentCommandReceipt[]

  @@unique([assignmentId, consentSeq])
  @@index([assignmentId])
  @@map("study_consent_event")
}

/// Idempotency receipt for protocol register/freeze (spec §9). Concrete strong FK to AnalysisProtocol;
/// no polymorphic target. Append-only. `operationScope` is a trusted constant (CHECK in migration SQL).
model AnalysisProtocolCommandReceipt {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  /// PROTOCOL_REGISTER_V1 | PROTOCOL_FREEZE_V1 (CHECK, migration SQL).
  operationScope String
  idempotencyKey String
  requestHash    String

  analysisProtocolId String           @db.Uuid
  analysisProtocol   AnalysisProtocol @relation(fields: [analysisProtocolId], references: [id])

  createdAt DateTime @default(now()) @db.Timestamptz(6)

  @@unique([operationScope, idempotencyKey])
  @@index([analysisProtocolId])
  @@map("analysis_protocol_command_receipt")
}

/// Idempotency receipt for experiment creation (spec §9). Concrete FK to Experiment. Append-only.
model ExperimentCreateReceipt {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  /// EXPERIMENT_CREATE_V1 (CHECK, migration SQL).
  operationScope String
  idempotencyKey String
  requestHash    String

  experimentId String     @db.Uuid
  experiment   Experiment @relation(fields: [experimentId], references: [id])

  createdAt DateTime @default(now()) @db.Timestamptz(6)

  @@unique([operationScope, idempotencyKey])
  @@index([experimentId])
  @@map("experiment_create_receipt")
}

/// Idempotency receipt for participant registration (spec §6/§9). Concrete FK to StudyParticipant.
/// Append-only. A different transport key for the same subject aliases the same participant.
model StudyParticipantRegistrationReceipt {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  /// PARTICIPANT_REGISTER_V1 (CHECK, migration SQL).
  operationScope String
  idempotencyKey String
  requestHash    String

  participantId String           @db.Uuid
  participant   StudyParticipant @relation(fields: [participantId], references: [id])

  createdAt DateTime @default(now()) @db.Timestamptz(6)

  @@unique([operationScope, idempotencyKey])
  @@index([participantId])
  @@map("study_participant_registration_receipt")
}

/// Idempotency receipt for participant assignment (spec §9). Concrete FK to ExperimentAssignment.
model ExperimentAssignmentReceipt {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  /// ASSIGN_PARTICIPANT_V1 (CHECK, migration SQL).
  operationScope String
  idempotencyKey String
  requestHash    String

  assignmentId String               @db.Uuid
  assignment   ExperimentAssignment @relation(fields: [assignmentId], references: [id])

  createdAt DateTime @default(now()) @db.Timestamptz(6)

  @@unique([operationScope, idempotencyKey])
  @@index([assignmentId])
  @@map("experiment_assignment_receipt")
}

/// Idempotency receipt for a consent command (spec §8.5/§8.9/§9). `consentEventId` references the
/// event representing the DURABLE effective state associated with the command (not universally the
/// event created by the command); `resultKind` distinguishes EVENT_APPENDED / NO_OP_EFFECTIVE_STATE /
/// CORRECTION_NOT_APPLIED. Concrete FK, no nullable/polymorphic target. Append-only.
model StudyConsentCommandReceipt {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  /// CONSENT_GRANT_V1 | CONSENT_WITHDRAW_V1 (CHECK, migration SQL).
  operationScope String
  idempotencyKey String
  requestHash    String

  resultKind StudyConsentResultKind

  consentEventId String            @db.Uuid
  consentEvent   StudyConsentEvent @relation(fields: [consentEventId], references: [id])

  createdAt DateTime @default(now()) @db.Timestamptz(6)

  @@unique([operationScope, idempotencyKey])
  @@index([consentEventId])
  @@map("study_consent_command_receipt")
}

// ===================================================================================================
// M3.5B-A2 — PurchaseIntent lifecycle · deterministic decision freeze · exact snapshot binding.
// ADDITIVE over accepted A1/M3.5A. Append-only scientific tables (immutability triggers in migration
// SQL). The two virtual back-relation fields above on DecisionSnapshot / ExperimentAssignment add NO
// SQL columns (Prisma relational completeness only; SCI-A2-13).
// ===================================================================================================

/// Trusted server-resolved capture provenance (A2 §8; Phase 0A §29). Never participant-selected.
enum EntrySource {
  DIRECT
  CONTENT
  SHARED_LINK
  RESEARCH_LINK
  AUTH_LINK
  SAVED_DECISION
  OTHER
}

/// Immutable initiation intent type (A2 §4; Phase 0A §29).
enum PurchaseIntentType {
  BUYING_NOW
  BUYING_TODAY
  CONSIDERING_LATER
  EXPLORATORY
}

/// A2 complete-signature families (A2 §1/§3). One discriminant per context version.
enum PurchaseSignatureKindA2 {
  BILL
  TICKETS
  EXACT_ITEMS
  NOMINAL_PACKAGE
}

/// Typed invalidation reason codes (A2 §10) — no free text as scientific input.
enum PurchaseIntentInvalidationReason {
  SUPERSEDED_BY_REPLACEMENT
  PARTICIPANT_CORRECTION
  DATA_ENTRY_ERROR
  OTHER
}

enum PurchaseIntentCreateResultKind {
  CREATED
  CAPTURE_ALIAS
}

enum PurchaseIntentContextResultKind {
  APPENDED
  CONTEXT_ALIAS
}

enum EligibilityProfileResultKind {
  APPENDED
  PROFILE_ALIAS
}

enum PurchaseIntentFinalizationResultKind {
  FINALIZED
  FINALIZE_ALIAS
}

enum PurchaseIntentInvalidationResultKind {
  INVALIDATED
  INVALIDATE_ALIAS
}

/// Server-issued durable capture token, idempotent on a client-held correlation nonce, immutably
/// bound to the trusted assignment + trusted entrySource (A2 §5). Append-only.
model PurchaseIntentCaptureToken {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  assignmentId String               @db.Uuid
  assignment   ExperimentAssignment @relation(fields: [assignmentId], references: [id])

  /// Untrusted client-held correlation material (A2 §13.1). Makes issuance idempotent per assignment.
  clientCorrelationNonce String

  /// Server-minted opaque stable capture identity (never client-chosen).
  intentCaptureKey String @unique

  /// Trusted server-resolved entry provenance (A2 §8); immutable.
  entrySource EntrySource

  issuedAt DateTime @default(now()) @db.Timestamptz(6)

  purchaseIntent PurchaseIntent?

  @@unique([assignmentId, clientCorrelationNonce])
  @@index([assignmentId])
  @@map("purchase_intent_capture_token")
}

/// Immutable PurchaseIntent root (A2 §4). `id` is the SOLE basis of decision identity. Assignment +
/// entrySource are reached ONLY through the capture token (no independent assignment field). Append-only.
model PurchaseIntent {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  /// Structural capture binding (A2 §5/§20): one token → at most one intent.
  captureTokenId String                     @unique @db.Uuid
  captureToken   PurchaseIntentCaptureToken @relation(fields: [captureTokenId], references: [id])

  intentType  PurchaseIntentType
  initiatedAt DateTime           @db.Timestamptz(6)
  createdAt   DateTime           @default(now()) @db.Timestamptz(6)

  contextVersions            PurchaseIntentContextVersion[]
  finalization               PurchaseIntentFinalization?
  decisionRequest            PurchaseIntentDecisionRequest?
  invalidationAsInvalidated  PurchaseIntentInvalidation?    @relation("invalidatedIntent")
  invalidationsAsReplacement PurchaseIntentInvalidation[]   @relation("replacementIntent")
  createReceipts             PurchaseIntentCreateReceipt[]

  @@map("purchase_intent")
}

/// Append-only corrigible context capture (A2 §8). Exactly one complete purchase signature per version
/// (discriminant + normalized JSON). `contextCaptureKey` is the exact context-command identity.
model PurchaseIntentContextVersion {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  intentId String         @db.Uuid
  intent   PurchaseIntent @relation(fields: [intentId], references: [id])

  /// Monotonic per intent (allocated under the PurchaseIntent row lock).
  contextSeq Int

  /// Client-held correlation identity for one exact context capture (A2 §13.2).
  contextCaptureKey    String
  contextSchemaVersion String

  merchantId            String
  signatureKind         PurchaseSignatureKindA2
  intendedTransactionAt DateTime                @db.Timestamptz(6)

  /// The exact normalized discriminated purchase signature (authority). JSONB.
  purchaseSignatureJson Json @db.JsonB

  capturedAt DateTime @db.Timestamptz(6)
  recordedAt DateTime @default(now()) @db.Timestamptz(6)

  finalizations   PurchaseIntentFinalization[]
  contextReceipts PurchaseIntentContextCommandReceipt[]

  @@unique([intentId, contextSeq])
  @@unique([intentId, contextCaptureKey])
  @@index([intentId])
  @@map("purchase_intent_context_version")
}

/// Append-only, assignment-scoped participant eligibility-profile version (A2 §10). The normalized
/// EligibilityPortfolio (card-number-free) is pinned by finalization into the frozen DecideInput.
model EligibilityProfileVersion {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  assignmentId String               @db.Uuid
  assignment   ExperimentAssignment @relation(fields: [assignmentId], references: [id])

  profileSeq Int

  profileCaptureKey      String
  portfolioSchemaVersion String

  /// The normalized EligibilityPortfolio (A2 §9). JSONB. No PAN/CVV/credentials/transactions.
  portfolioJson Json @db.JsonB

  capturedAt DateTime @db.Timestamptz(6)
  recordedAt DateTime @default(now()) @db.Timestamptz(6)

  finalizations   PurchaseIntentFinalization[]
  profileReceipts EligibilityProfileCommandReceipt[]

  @@unique([assignmentId, profileSeq])
  @@unique([assignmentId, profileCaptureKey])
  @@index([assignmentId])
  @@map("eligibility_profile_version")
}

/// Exactly one effective finalization per intent (A2 §9), pinning the exact context + eligibility
/// profile versions. Append-only. Cross-table coherence (context/profile belong to the intent's
/// assignment) is enforced by an insert-time trigger (migration SQL).
model PurchaseIntentFinalization {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  intentId String         @unique @db.Uuid
  intent   PurchaseIntent @relation(fields: [intentId], references: [id])

  contextVersionId String                       @db.Uuid
  contextVersion   PurchaseIntentContextVersion @relation(fields: [contextVersionId], references: [id])

  eligibilityProfileVersionId String                    @db.Uuid
  eligibilityProfileVersion   EligibilityProfileVersion @relation(fields: [eligibilityProfileVersionId], references: [id])

  finalizedAt DateTime @db.Timestamptz(6)

  decisionRequest      PurchaseIntentDecisionRequest?
  finalizationReceipts PurchaseIntentFinalizationReceipt[]

  @@index([contextVersionId])
  @@index([eligibilityProfileVersionId])
  @@map("purchase_intent_finalization")
}

/// Append-only invalidation lineage (A2 §10/§23). Replacement is a NEW root in the SAME assignment
/// (trigger); no self-link (CHECK); acyclic (service walk under the assignment lock).
model PurchaseIntentInvalidation {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  invalidatedIntentId String         @unique @db.Uuid
  invalidatedIntent   PurchaseIntent @relation("invalidatedIntent", fields: [invalidatedIntentId], references: [id])

  replacementIntentId String?         @db.Uuid
  replacementIntent   PurchaseIntent? @relation("replacementIntent", fields: [replacementIntentId], references: [id])

  invalidatedAt DateTime                          @db.Timestamptz(6)
  reasonCode    PurchaseIntentInvalidationReason?

  invalidationReceipts PurchaseIntentInvalidationReceipt[]

  @@index([replacementIntentId])
  @@map("purchase_intent_invalidation")
}

/// The exact immutable frozen decision request (A2 §12). Freezes the exact validated DecideInput +
/// hash + pinned semantic versions BEFORE M3.5A runs. Append-only; self-verified on load (A2 §19).
model PurchaseIntentDecisionRequest {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  intentId String         @unique @db.Uuid
  intent   PurchaseIntent @relation(fields: [intentId], references: [id])

  finalizationId String                     @unique @db.Uuid
  finalization   PurchaseIntentFinalization @relation(fields: [finalizationId], references: [id])

  decisionRequestSchemaVersion String

  /// The exact validated DecideInput (normalized semantic JSON). JSONB.
  exactValidatedDecideInputJson Json   @db.JsonB
  decideInputHash               String

  /// Pinned expected semantic versions (A2 §14).
  expectedEngineInputSchemaVersion String
  expectedEngineContractVersion    String
  expectedCorpusVersion            String
  holidayCalendarVersion           String

  /// Derived identities (A2 §11/§15).
  businessDecisionKey String @unique
  m3_5aIdempotencyKey String @unique

  createdAt DateTime @default(now()) @db.Timestamptz(6)

  binding PurchaseIntentDecisionBinding?

  @@map("purchase_intent_decision_request")
}

/// Exact 1:1 intent↔snapshot binding (A2 §16). No free-standing intentId — the intent is reached only
/// via decisionRequestId, so cross-wiring is structurally impossible. Append-only.
model PurchaseIntentDecisionBinding {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  decisionRequestId String                        @unique @db.Uuid
  decisionRequest   PurchaseIntentDecisionRequest @relation(fields: [decisionRequestId], references: [id])

  /// FK to the immutable M3.5A snapshot (ON DELETE RESTRICT; snapshots are never deleted).
  snapshotId String           @unique @db.Uuid
  snapshot   DecisionSnapshot @relation(fields: [snapshotId], references: [id])

  boundAt DateTime @default(now()) @db.Timestamptz(6)

  @@map("purchase_intent_decision_binding")
}

/// Transport idempotency receipt for createPurchaseIntent (A2 §24). Concrete FK; append-only.
model PurchaseIntentCreateReceipt {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  operationScope String
  idempotencyKey String
  requestHash    String
  resultKind     PurchaseIntentCreateResultKind

  intentId String         @db.Uuid
  intent   PurchaseIntent @relation(fields: [intentId], references: [id])

  createdAt DateTime @default(now()) @db.Timestamptz(6)

  @@unique([operationScope, idempotencyKey])
  @@index([intentId])
  @@map("purchase_intent_create_receipt")
}

