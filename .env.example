# PagaMenos — validation system · environment template (M0).
# Copy to `.env` and fill locally. NEVER commit real secrets.
#
# --- Server-only secrets (MUST NOT be exposed via NEXT_PUBLIC_*) ---
# PostgreSQL connection string (required from M1/M3.5 onward; unused in M0).
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/pagamenos_validation?schema=public"
NODE_ENV="development"

# --- Public, client-safe values ---
NEXT_PUBLIC_APP_NAME="PagaMenos (validation)"
